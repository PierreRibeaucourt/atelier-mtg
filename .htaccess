# Page d'accueil de l'Atelier MTG, publiée par outils/atelier/site_atelier.py : ne pas modifier ici
Options -Indexes
RewriteEngine On
RewriteCond %{REQUEST_URI} !^/\.well-known/
RewriteCond %{HTTPS} off [OR]
RewriteCond %{HTTP_HOST} !^atelier\-mtg\.com$ [NC]
RewriteRule ^ https://atelier-mtg.com%{REQUEST_URI} [L,R=301]
# la page d'accueil est en français, sous /fr/ ; la racine y renvoie en attendant la version anglaise
RewriteRule ^$ /fr/ [R=302,L]
# les adresses françaises d'avant /fr/
RewriteRule ^(recherche|mentions-legales|confidentialite)(?:/(.*))?$ /fr/$1/$2 [R=301,L]
# une adresse inconnue ; celle d'un deck privé, ouverte par son propriétaire, l'emmène dans l'appli (introuvable())
ErrorDocument 404 /fr/introuvable.html
# l'appli (mes-decks/, telephone_site.py) : son manifeste, et son service worker toujours relu
AddType application/manifest+json .webmanifest
<IfModule mod_headers.c>
  <Files "sw.js">
    Header set Cache-Control "no-cache"
  </Files>
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType text/javascript "access plus 1 year"
  ExpiresByType image/webp "access plus 1 month"
  ExpiresByType image/jpeg "access plus 1 month"
</IfModule>
